# Neon PostgreSQL — development branch connection string.
# Used by the Prisma CLI (prisma.config.ts) and the app runtime (src/lib/prisma.ts).
# Get this from the Neon console: Project > Branch > Connection Details.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/devstash?sslmode=require"

# Shadow database for `prisma migrate dev` against a cloud-hosted dev DB.
# Create a second Neon branch (e.g. "shadow") and paste its connection string here.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@SHADOW_HOST/devstash?sslmode=require"

# Auth.js (NextAuth v5).
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 33`).
AUTH_SECRET=""
# GitHub OAuth app credentials — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend — transactional email (account verification links).
# API key: https://resend.com/api-keys
RESEND_API_KEY=""
# From address. Must be on a domain verified in Resend. Leave blank in local dev
# to fall back to Resend's shared "onboarding@resend.dev" test sender.
EMAIL_FROM="DevStash <noreply@yourdomain.com>"
# Optional. Absolute origin for links in emails. Leave blank to derive it from
# the incoming request (correct for local dev); set it in production.
NEXT_PUBLIC_APP_URL="https://devstash.app"

# Upstash Redis — REST credentials for rate limiting the auth endpoints
# (@upstash/ratelimit). Create a Redis database at https://console.upstash.com
# and copy its REST URL + token from the database's "REST API" section.
# Leave both blank to disable rate limiting entirely — it fails open, which is
# fine for local dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email verification toggle. Unset (or anything but "false") = new email/password
# accounts must confirm their address via a Resend link before they can sign in.
# Set to "false" to disable that entirely — needed while no domain is verified in
# Resend, since the shared test sender only delivers to the Resend account
# owner's own address. GitHub OAuth is unaffected either way.
EMAIL_VERIFICATION_ENABLED="true"

# Cloudflare R2 storage — backs the `file` / `image` item types. Create an R2
# bucket + an API token (Object Read & Write) in the Cloudflare dashboard.
# Leave any of these blank to disable uploads: the "New item" file/image types
# then report "uploads aren't configured" instead of crashing.
#   R2_ACCOUNT_ID       — Cloudflare account id (the R2 endpoint subdomain)
#   R2_ACCESS_KEY_ID    — R2 API token access key
#   R2_SECRET_ACCESS_KEY— R2 API token secret
#   R2_BUCKET_NAME      — the bucket to store uploads in
# Objects are served back through /api/files/[id] (a private, same-origin
# proxy), so no public bucket URL is needed.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Stripe — subscription billing (DevStash Pro).
#   STRIPE_SECRET_KEY       — sk_test_… / sk_live_…  (Developers > API keys)
#   STRIPE_WEBHOOK_SECRET   — whsec_…  (Phase 2: `stripe listen` locally, or the
#                             webhook endpoint's signing secret in the Dashboard)
#   STRIPE_PRICE_ID_MONTHLY — price_…  ($8/mo recurring price)
#   STRIPE_PRICE_ID_YEARLY  — price_…  ($72/yr recurring price)
#   STRIPE_PUBLISHABLE_KEY  — pk_test_… (only if Stripe.js/Elements is added
#                             later; hosted Checkout does not need it)
# Leave STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET blank to disable billing —
# the Phase 2 endpoints then return 503 and nothing else breaks.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Open AI Key
OPENAI_API_KEY=""
