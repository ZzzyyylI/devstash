# Neon PostgreSQL — development branch connection string.
# Used by the Prisma CLI (prisma.config.ts) and the app runtime (src/lib/prisma.ts).
# Get this from the Neon console: Project > Branch > Connection Details.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/devstash?sslmode=require"

# Shadow database for `prisma migrate dev` against a cloud-hosted dev DB.
# Create a second Neon branch (e.g. "shadow") and paste its connection string here.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@SHADOW_HOST/devstash?sslmode=require"
